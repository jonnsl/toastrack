# Maintainer: Jonnathan Soares <jonnsl@hotmail.com>

pkgname=toastrack-git
_pkgname=toastrack
pkgver=0.1.0.r1.g0000000
pkgrel=1
pkgdesc='Browse and search the history of your desktop notifications'
arch=('x86_64')
url='https://github.com/jonnsl/toastrack'
license=('GPL-3.0-or-later')
depends=(
  'gcc-libs'
  'glib2'
  'gtk4'
  'libadwaita'
  'sqlite'
  'systemd'
  'hicolor-icon-theme'
)
makedepends=(
  'git'
  'meson'
  'vala'
  'blueprint-compiler'
  'cargo'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
install=toastrack.install
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local base
  base=$(sed -n "s/^ *version: *'\([^']*\)'.*/\1/p" meson.build | head -n1)
  printf '%s.r%s.g%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname/daemon"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_NET_OFFLINE=true
  arch-meson "$_pkgname" build -Dprofile=default
  meson compile -C build
}

check() {
  export CARGO_NET_OFFLINE=true
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
